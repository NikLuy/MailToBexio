# Microsoft Graph (App-Only Auth)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
TARGET_MAILBOX_UPN=postfach@example.com
TARGET_MAILBOX_FOLDER=Kunden_Erfassung
TARGET_MAILBOX_DONE_FOLDER=Done
TARGET_MAILBOX_FAULT_FOLDER=Fault

# bexio API (statischer API-Key aus Einstellungen → API-Schlüssel)
BEXIO_API_KEY=your-bexio-api-key-here
BEXIO_USER_ID=1
BEXIO_OWNER_ID=1

# AI Provider: Copilot | Gemini | Ollama  (Default: Copilot)
AI_PROVIDER=Copilot

# Azure OpenAI / Copilot (Standard)
# Endpoint: Azure Portal → deine OpenAI-Ressource → Schlüssel und Endpunkt
# Deployment: Azure AI Studio → Deployments → Name des Modells (z.B. gpt-4o)
COPILOT_ENDPOINT=https://your-resource.openai.azure.com/
COPILOT_API_KEY=your-azure-openai-api-key-here
COPILOT_DEPLOYMENT_NAME=gpt-4o

# Gemini (nur wenn AI_PROVIDER=Gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Ollama (nur wenn AI_PROVIDER=Ollama, lokal oder im Netzwerk)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_PORT=11434

# Worker-Intervall in Minuten
WORKER_INTERVAL_MINUTES=5
